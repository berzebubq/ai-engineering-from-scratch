# -----------------------------------------------------------------------------
#  AI Pet-SMM Analytics — переменные окружения
#
#  Скопируйте в .env.local и подставьте свои значения:
#      cp .env.example .env.local
#
#  .env.local уже в .gitignore и в репозиторий не попадёт.
#  Значения берутся в Supabase Dashboard → Project Settings → API.
# -----------------------------------------------------------------------------

# URL проекта, вида https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Публичный "anon" ключ.
#
# Префикс NEXT_PUBLIC_ означает, что ключ вшивается в браузерный бандл и виден
# любому посетителю — так и задумано Supabase. Безопасность обеспечивает не
# секретность ключа, а RLS-политики в supabase-schema.sql. Пока там действуют
# dev-политики (раздел 6a), считайте базу публичной.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
#  НЕ добавляйте сюда service_role ключ.
#
#  Он игнорирует RLS целиком. Ему нечего делать в Next.js-приложении, откуда
#  его легко случайно импортировать в клиентский компонент. Понадобится он
#  позже — в фоновых воркерах Vision/Whisper, у которых свой рантайм.
# -----------------------------------------------------------------------------
