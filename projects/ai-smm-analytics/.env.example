# -----------------------------------------------------------------------------
#  AI Pet-SMM Analytics — переменные окружения
#
#  Скопируйте в .env.local и подставьте свои значения:
#      cp .env.example .env.local
#
#  .env.local уже в .gitignore и в репозиторий не попадёт.
#  Значения берутся в Supabase Dashboard → Project Settings → API.
# -----------------------------------------------------------------------------

# URL проекта, вида https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Публичный "anon" ключ.
#
# Префикс NEXT_PUBLIC_ означает, что ключ вшивается в браузерный бандл и виден
# любому посетителю — так и задумано Supabase. Безопасность обеспечивает не
# секретность ключа, а RLS-политики в supabase-schema.sql. Пока там действуют
# dev-политики (раздел 6a), считайте базу публичной.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
#  Instagram Graph API — для кнопки «Синхронизировать статистику».
#
#  Без префикса NEXT_PUBLIC_ и намеренно: токен даёт доступ к аккаунту, в
#  браузерный бандл ему нельзя. Если синхронизация не нужна — оставьте пустыми,
#  приложение будет работать, кнопка просто останется неактивной.
#
#  Где взять: developers.facebook.com → ваше приложение → Instagram Graph API.
#  Токену нужны права instagram_basic и instagram_manage_insights, а аккаунт
#  должен быть Business или Creator — у личного статистики нет вообще.
# -----------------------------------------------------------------------------

# Числовой ID Instagram-аккаунта (НЕ имя пользователя).
INSTAGRAM_ACCOUNT_ID=

# Долгоживущий access token. Живёт ~60 дней, потом выпускается заново.
META_ACCESS_TOKEN=

# Необязательные. Меняйте, только если знаете зачем.
#   META_GRAPH_API_VERSION  — версия API, по умолчанию v21.0
#   META_MAX_MEDIA          — сколько видео тянуть за раз, по умолчанию 50
#   META_GRAPH_API_BASE_URL — подмена адреса API, нужна только для тестов
# META_GRAPH_API_VERSION=v21.0
# META_MAX_MEDIA=50

# -----------------------------------------------------------------------------
#  Строка подключения к Postgres — ТОЛЬКО для применения схемы (npm run db:push).
#
#  Приложению она не нужна: Next.js ходит в базу через anon-ключ выше. Никогда
#  не добавляйте к ней префикс NEXT_PUBLIC_ — пароль уедет в браузер.
#
#  Берётся в Supabase Dashboard → Connect. Там два варианта:
#    • Direct connection (db.<ref>.supabase.co) — работает только по IPv6.
#    • Session pooler — по IPv4; берите его, если IPv6 у провайдера нет.
# -----------------------------------------------------------------------------

DATABASE_URL=

# -----------------------------------------------------------------------------
#  НЕ добавляйте сюда service_role ключ.
#
#  Он игнорирует RLS целиком. Ему нечего делать в Next.js-приложении, откуда
#  его легко случайно импортировать в клиентский компонент. Понадобится он
#  позже — в фоновых воркерах Vision/Whisper, у которых свой рантайм.
# -----------------------------------------------------------------------------
